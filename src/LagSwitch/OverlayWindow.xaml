<Window x:Class="LagSwitch.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LagSwitch"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowActivated="False"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Focusable="False"
        IsHitTestVisible="False"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Border x:Name="Shell"
            Background="{DynamicResource OverlayFace}"
            BorderBrush="{DynamicResource Online}"
            BorderThickness="1"
            Padding="12,6">
        <StackPanel Orientation="Horizontal">
            <Rectangle x:Name="Dot" Width="8" Height="8" VerticalAlignment="Center"
                       Fill="{DynamicResource Online}" />
            <TextBlock x:Name="Label" Text="EN LIGNE" Margin="8,0,0,0"
                       FontFamily="{StaticResource TerminalFont}"
                       FontSize="12" FontWeight="Bold"
                       Foreground="{DynamicResource Online}" VerticalAlignment="Center" />
        </StackPanel>
    </Border>
</Window>
