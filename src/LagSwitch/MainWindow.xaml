<Window x:Class="LagSwitch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LagSwitch"
        Height="820" Width="660"
        MinHeight="620" MinWidth="560"
        Background="{StaticResource Background}"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===================================================== en-tete -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="LagSwitch" Style="{StaticResource H1}" />
            <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0"
                       Text="Simulateur de conditions reseau : coupe et retablit la connexion a la demande." />
        </StackPanel>

        <!-- ================================================== etat + action -->
        <Border Grid.Row="1" Style="{StaticResource CardPanel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StateDot" Width="12" Height="12" VerticalAlignment="Center"
                                 Fill="{StaticResource Online}" />
                        <TextBlock x:Name="StateText" Text="EN LIGNE" Margin="10,0,0,0"
                                   FontSize="24" FontWeight="Bold"
                                   Foreground="{StaticResource Online}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="StateDetail" Style="{StaticResource Hint}" Margin="22,4,0,0"
                               Text="Aucune coupure en cours." />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="CutButton" Content="COUPER" Style="{StaticResource BigButton}"
                            Width="150" Margin="0,0,8,0" Click="OnCutButton" />
                    <Button x:Name="PanicButton" Content="PANIQUE" Style="{StaticResource DangerButton}"
                            Padding="14,14" Click="OnPanic"
                            ToolTip="Retablit la connexion immediatement, quel que soit le mode." />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================================================== reglages -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
            <StackPanel>

                <!-- ===== pare-feu : sans lui, rien ne bloque. En tete de liste. -->
                <Border Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock Text="PARE-FEU WINDOWS" Style="{StaticResource CardTitle}" />
                        <TextBlock x:Name="FirewallStateText" Style="{StaticResource Body}"
                                   Text="Verification en cours..." />
                        <StackPanel x:Name="FirewallFixPanel" Margin="0,10,0,0" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Les regles de blocage n'ont aucun effet tant que le pare-feu Windows est eteint. L'activer retablit aussi le blocage des connexions entrantes non sollicitees : cela peut couper un hebergement local, une VM ou un partage reseau." />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button x:Name="EnableFirewallButton" Content="Activer le pare-feu Windows"
                                        Style="{StaticResource WarnButton}" Click="OnEnableFirewall" />
                                <Button Content="Reverifier" Style="{StaticResource BaseButton}"
                                        Margin="8,0,0,0" Click="OnRecheckFirewall" />
                            </StackPanel>
                            <CheckBox x:Name="RestoreFirewallCheck" Margin="0,10,0,0"
                                      Content="Le remettre comme avant en quittant LagSwitch"
                                      Click="OnRestoreFirewallChanged" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ===== cible -->
                <Border Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock Text="CIBLE" Style="{StaticResource CardTitle}" />

                        <RadioButton x:Name="TargetAllRadio" GroupName="Target"
                                     Content="Toute la connexion de la machine"
                                     Checked="OnTargetChanged" />
                        <RadioButton x:Name="TargetAppRadio" GroupName="Target"
                                     Content="Une seule application"
                                     Checked="OnTargetChanged" />

                        <Grid Margin="22,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="{StaticResource Field}"
                                    BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                                    CornerRadius="6" Padding="10,7" Margin="0,0,8,0">
                                <TextBlock x:Name="TargetPathText" Style="{StaticResource Mono}"
                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                           Text="aucune application choisie" />
                            </Border>

                            <Button Grid.Column="1" x:Name="PickAppButton" Content="Ouvertes..."
                                    Style="{StaticResource BaseButton}" Margin="0,0,8,0" Click="OnPickApp" />
                            <Button Grid.Column="2" x:Name="BrowseButton" Content="Parcourir..."
                                    Style="{StaticResource BaseButton}" Click="OnBrowse" />
                        </Grid>

                        <TextBlock Style="{StaticResource Hint}" Margin="22,8,0,0"
                                   Text="Cibler une seule application evite de couper le reste de la machine (chat vocal, navigateur, Studio)." />
                    </StackPanel>
                </Border>

                <!-- ===== mode -->
                <Border Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock Text="MODE" Style="{StaticResource CardTitle}" />

                        <RadioButton x:Name="ModeToggleRadio" GroupName="Mode" Checked="OnModeChanged"
                                     Content="Bascule — une pression coupe, la suivante retablit" />
                        <RadioButton x:Name="ModeBurstRadio" GroupName="Mode" Checked="OnModeChanged"
                                     Content="Impulsion — coupe pendant une duree fixe, puis retablit seule" />
                        <RadioButton x:Name="ModeHoldRadio" GroupName="Mode" Checked="OnModeChanged"
                                     Content="Maintien — coupe tant que la touche reste enfoncee" />
                        <RadioButton x:Name="ModeFlickerRadio" GroupName="Mode" Checked="OnModeChanged"
                                     Content="Instable — alterne coupures et retours, simule une perte de paquets" />

                        <StackPanel x:Name="BurstPanel" Orientation="Horizontal" Margin="22,10,0,0">
                            <TextBlock Text="Duree de l'impulsion" Style="{StaticResource Body}"
                                       VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBox x:Name="BurstBox" Style="{StaticResource NumberBox}"
                                     LostFocus="OnNumbersChanged" />
                            <TextBlock Text="ms" Style="{StaticResource Hint}"
                                       VerticalAlignment="Center" Margin="8,0,0,0" />
                        </StackPanel>

                        <StackPanel x:Name="FlickerPanel" Margin="22,10,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Coupe" Style="{StaticResource Body}"
                                           VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBox x:Name="FlickerCutBox" Style="{StaticResource NumberBox}"
                                         LostFocus="OnNumbersChanged" />
                                <TextBlock Text="ms, puis en ligne" Style="{StaticResource Hint}"
                                           VerticalAlignment="Center" Margin="8,0,10,0" />
                                <TextBox x:Name="FlickerGapBox" Style="{StaticResource NumberBox}"
                                         LostFocus="OnNumbersChanged" />
                                <TextBlock Text="ms" Style="{StaticResource Hint}"
                                           VerticalAlignment="Center" Margin="8,0,0,0" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="Micro-coupures" Style="{StaticResource BaseButton}"
                                        Padding="10,6" FontSize="12" Margin="0,0,8,0"
                                        Tag="80,600" Click="OnFlickerPreset" />
                                <Button Content="Reseau instable" Style="{StaticResource BaseButton}"
                                        Padding="10,6" FontSize="12" Margin="0,0,8,0"
                                        Tag="200,350" Click="OnFlickerPreset" />
                                <Button Content="Perte lourde" Style="{StaticResource BaseButton}"
                                        Padding="10,6" FontSize="12"
                                        Tag="500,200" Click="OnFlickerPreset" />
                            </StackPanel>

                            <TextBlock x:Name="FlickerSummary" Style="{StaticResource Hint}" Margin="0,8,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ===== raccourci -->
                <Border Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock Text="RACCOURCI" Style="{StaticResource CardTitle}" />

                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="HotkeyButton" Style="{StaticResource BaseButton}"
                                    Width="200" Content="F8" Click="OnCaptureHotkey"
                                    PreviewKeyDown="OnHotkeyKeyDown" />
                            <TextBlock x:Name="HotkeyStatus" Style="{StaticResource Hint}"
                                       VerticalAlignment="Center" Margin="12,0,0,0" />
                        </StackPanel>

                        <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                                   Text="Le raccourci marche meme quand une autre application est au premier plan, et elle ne recoit pas la touche. Evite donc une touche dont tu te sers en jeu." />
                    </StackPanel>
                </Border>

                <!-- ===== securite -->
                <Border Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock Text="GARDE-FOUS" Style="{StaticResource CardTitle}" />

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Retablir automatiquement apres" Style="{StaticResource Body}"
                                       VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBox x:Name="MaxSecondsBox" Style="{StaticResource NumberBox}"
                                     LostFocus="OnNumbersChanged" />
                            <TextBlock Text="secondes" Style="{StaticResource Hint}"
                                       VerticalAlignment="Center" Margin="8,0,0,0" />
                        </StackPanel>

                        <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                                   Text="Les regles sont aussi retirees a la fermeture, en cas d'erreur, et au demarrage suivant si l'application a ete tuee." />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ==================================================== journal -->
        <Border Grid.Row="3" Style="{StaticResource CardPanel}" Margin="0,12,0,0" Padding="14,12">
            <StackPanel>
                <TextBlock Text="JOURNAL" Style="{StaticResource CardTitle}" Margin="0,0,0,6" />
                <ItemsControl x:Name="LogList" Height="86">
                    <ItemsControl.Template>
                        <ControlTemplate TargetType="ItemsControl">
                            <ScrollViewer x:Name="LogScroller" VerticalScrollBarVisibility="Auto">
                                <ItemsPresenter />
                            </ScrollViewer>
                        </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Style="{StaticResource Mono}" Margin="0,1" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </Grid>
</Window>
