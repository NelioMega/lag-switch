<Window x:Class="LagSwitch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="LagSwitch"
        Height="840" Width="680"
        MinHeight="640" MinWidth="600"
        WindowStyle="None"
        ResizeMode="CanResize"
        Icon="Assets/lagswitch.ico"
        Background="Transparent"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border Background="{StaticResource Background}"
            BorderBrush="{StaticResource CardBorderLit}"
            BorderThickness="1">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Margin" Value="0" />
                <Style.Triggers>
                    <!-- Sans cette marge, une fenetre WindowChrome maximisee deborde de l'ecran. -->
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}"
                                 Value="Maximized">
                        <Setter Property="Margin" Value="7" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <Grid Margin="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="36" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- ===== barre de titre -->
                <Grid Grid.Row="0" Background="{StaticResource Card}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                        <Image Source="Assets/logo.png" Width="20" Height="20" />
                        <TextBlock Text="LAGSWITCH" Style="{StaticResource H1}"
                                   VerticalAlignment="Center" Margin="9,0,0,0" />
                        <TextBlock x:Name="VersionText" Style="{StaticResource Hint}"
                                   VerticalAlignment="Center" Margin="8,1,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Content="_" Style="{StaticResource ChromeButton}" Click="OnMinimize" />
                        <Button Content="X" Style="{StaticResource ChromeButton}" Click="OnCloseWindow" />
                    </StackPanel>

                    <Rectangle Grid.ColumnSpan="3" Height="1" VerticalAlignment="Bottom"
                               Fill="{StaticResource CardBorder}" />
                </Grid>

                <!-- ===== etat + action -->
                <Border Grid.Row="1" Style="{StaticResource CardPanel}" Margin="14,14,14,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Rectangle x:Name="StateDot" Width="10" Height="10"
                                           VerticalAlignment="Center" Fill="{StaticResource Online}" />
                                <TextBlock x:Name="StateText" Text="[ EN LIGNE ]" Margin="10,0,0,0"
                                           FontFamily="{StaticResource TerminalFont}"
                                           FontSize="21" FontWeight="Bold"
                                           Foreground="{StaticResource Online}" VerticalAlignment="Center" />
                                <TextBlock x:Name="Caret" Text="_" Margin="3,0,0,0"
                                           FontFamily="{StaticResource TerminalFont}"
                                           FontSize="21" FontWeight="Bold"
                                           Foreground="{StaticResource Online}" VerticalAlignment="Center">
                                    <TextBlock.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity"
                                                                                   Duration="0:0:1">
                                                        <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                                        <DiscreteDoubleKeyFrame KeyTime="0:0:0.5" Value="0" />
                                                    </DoubleAnimationUsingKeyFrames>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </TextBlock.Triggers>
                                </TextBlock>
                            </StackPanel>
                            <TextBlock x:Name="StateDetail" Style="{StaticResource Hint}" Margin="20,6,0,0"
                                       Text="initialisation..." />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="CutButton" Content="COUPER" Style="{StaticResource BigButton}"
                                    Width="140" Margin="0,0,8,0" Click="OnCutButton" />
                            <Button x:Name="PanicButton" Content="PANIC" Style="{StaticResource DangerButton}"
                                    Padding="14,12" Click="OnPanic"
                                    ToolTip="Retablit la connexion immediatement, quel que soit le mode." />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ===== reglages -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="14,0,8,0" Padding="0,0,6,0">
                    <StackPanel>

                        <!-- ===== pare-feu : sans lui, rien ne bloque. En tete de liste. -->
                        <Border Style="{StaticResource CardPanel}">
                            <StackPanel>
                                <TextBlock Text="// PARE-FEU WINDOWS" Style="{StaticResource CardTitle}" />
                                <Rectangle Style="{StaticResource Rule}" />
                                <TextBlock x:Name="FirewallStateText" Style="{StaticResource Body}"
                                           Text="verification en cours..." />
                                <StackPanel x:Name="FirewallFixPanel" Margin="0,10,0,0" Visibility="Collapsed">
                                    <TextBlock Style="{StaticResource Hint}"
                                               Text="Les regles de blocage n'ont aucun effet tant que le pare-feu Windows est eteint. L'activer retablit aussi le blocage des connexions entrantes non sollicitees : cela peut couper un hebergement local, une VM ou un partage reseau." />
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Button x:Name="EnableFirewallButton" Content="ACTIVER LE PARE-FEU"
                                                Style="{StaticResource WarnButton}" Click="OnEnableFirewall" />
                                        <Button Content="REVERIFIER" Style="{StaticResource BaseButton}"
                                                Margin="8,0,0,0" Click="OnRecheckFirewall" />
                                    </StackPanel>
                                    <CheckBox x:Name="RestoreFirewallCheck" Margin="0,10,0,0"
                                              Content="le remettre comme avant en quittant"
                                              Click="OnRestoreFirewallChanged" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- ===== cible -->
                        <Border Style="{StaticResource CardPanel}">
                            <StackPanel>
                                <TextBlock Text="// CIBLE" Style="{StaticResource CardTitle}" />
                                <Rectangle Style="{StaticResource Rule}" />

                                <RadioButton x:Name="TargetAllRadio" GroupName="Target"
                                             Content="toute la connexion de la machine"
                                             Checked="OnTargetChanged" />
                                <RadioButton x:Name="TargetAppRadio" GroupName="Target"
                                             Content="une seule application"
                                             Checked="OnTargetChanged" />

                                <Grid Margin="26,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Background="{StaticResource Field}"
                                            BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                                            Padding="9,6" Margin="0,0,8,0">
                                        <TextBlock x:Name="TargetPathText" Style="{StaticResource Mono}"
                                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                                   Text="aucune application choisie" />
                                    </Border>

                                    <Button Grid.Column="1" x:Name="PickAppButton" Content="OUVERTES"
                                            Style="{StaticResource BaseButton}" Margin="0,0,8,0" Click="OnPickApp" />
                                    <Button Grid.Column="2" x:Name="BrowseButton" Content="PARCOURIR"
                                            Style="{StaticResource BaseButton}" Click="OnBrowse" />
                                </Grid>

                                <TextBlock Style="{StaticResource Hint}" Margin="26,8,0,0"
                                           Text="Cibler une seule application evite de couper le reste de la machine (chat vocal, navigateur, Studio)." />
                            </StackPanel>
                        </Border>

                        <!-- ===== mode -->
                        <Border Style="{StaticResource CardPanel}">
                            <StackPanel>
                                <TextBlock Text="// MODE" Style="{StaticResource CardTitle}" />
                                <Rectangle Style="{StaticResource Rule}" />

                                <RadioButton x:Name="ModeToggleRadio" GroupName="Mode" Checked="OnModeChanged"
                                             Content="bascule    une pression coupe, la suivante retablit" />
                                <RadioButton x:Name="ModeBurstRadio" GroupName="Mode" Checked="OnModeChanged"
                                             Content="impulsion  coupe une duree fixe, puis retablit seule" />
                                <RadioButton x:Name="ModeHoldRadio" GroupName="Mode" Checked="OnModeChanged"
                                             Content="maintien   coupe tant que la touche reste enfoncee" />
                                <RadioButton x:Name="ModeFlickerRadio" GroupName="Mode" Checked="OnModeChanged"
                                             Content="instable   alterne coupures et retours (perte de paquets)" />

                                <StackPanel x:Name="BurstPanel" Orientation="Horizontal" Margin="26,12,0,0">
                                    <TextBlock Text="duree" Style="{StaticResource Body}"
                                               VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <TextBox x:Name="BurstBox" Style="{StaticResource NumberBox}"
                                             LostFocus="OnNumbersChanged" />
                                    <TextBlock Text="ms" Style="{StaticResource Hint}"
                                               VerticalAlignment="Center" Margin="8,0,0,0" />
                                </StackPanel>

                                <StackPanel x:Name="FlickerPanel" Margin="26,12,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="coupe" Style="{StaticResource Body}"
                                                   VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <TextBox x:Name="FlickerCutBox" Style="{StaticResource NumberBox}"
                                                 LostFocus="OnNumbersChanged" />
                                        <TextBlock Text="ms, puis en ligne" Style="{StaticResource Hint}"
                                                   VerticalAlignment="Center" Margin="8,0,10,0" />
                                        <TextBox x:Name="FlickerGapBox" Style="{StaticResource NumberBox}"
                                                 LostFocus="OnNumbersChanged" />
                                        <TextBlock Text="ms" Style="{StaticResource Hint}"
                                                   VerticalAlignment="Center" Margin="8,0,0,0" />
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Button Content="MICRO-COUPURES" Style="{StaticResource BaseButton}"
                                                Padding="9,5" FontSize="11" Margin="0,0,8,0"
                                                Tag="80,600" Click="OnFlickerPreset" />
                                        <Button Content="RESEAU INSTABLE" Style="{StaticResource BaseButton}"
                                                Padding="9,5" FontSize="11" Margin="0,0,8,0"
                                                Tag="200,350" Click="OnFlickerPreset" />
                                        <Button Content="PERTE LOURDE" Style="{StaticResource BaseButton}"
                                                Padding="9,5" FontSize="11"
                                                Tag="500,200" Click="OnFlickerPreset" />
                                    </StackPanel>

                                    <TextBlock x:Name="FlickerSummary" Style="{StaticResource Hint}" Margin="0,10,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- ===== raccourci -->
                        <Border Style="{StaticResource CardPanel}">
                            <StackPanel>
                                <TextBlock Text="// RACCOURCI" Style="{StaticResource CardTitle}" />
                                <Rectangle Style="{StaticResource Rule}" />

                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="HotkeyButton" Style="{StaticResource BaseButton}"
                                            Width="190" Content="F8" Click="OnCaptureHotkey"
                                            PreviewKeyDown="OnHotkeyKeyDown" />
                                    <TextBlock x:Name="HotkeyStatus" Style="{StaticResource Hint}"
                                               VerticalAlignment="Center" Margin="12,0,0,0" />
                                </StackPanel>

                                <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                                           Text="Le raccourci marche meme quand une autre application est au premier plan, et elle ne recoit pas la touche. Evite donc une touche dont tu te sers en jeu." />
                            </StackPanel>
                        </Border>

                        <!-- ===== garde-fous -->
                        <Border Style="{StaticResource CardPanel}">
                            <StackPanel>
                                <TextBlock Text="// GARDE-FOUS" Style="{StaticResource CardTitle}" />
                                <Rectangle Style="{StaticResource Rule}" />

                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="retablir apres" Style="{StaticResource Body}"
                                               VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <TextBox x:Name="MaxSecondsBox" Style="{StaticResource NumberBox}"
                                             LostFocus="OnNumbersChanged" />
                                    <TextBlock Text="secondes" Style="{StaticResource Hint}"
                                               VerticalAlignment="Center" Margin="8,0,0,0" />
                                </StackPanel>

                                <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                                           Text="Les regles sont aussi retirees a la fermeture, en cas d'erreur, et au demarrage suivant si l'application a ete tuee." />
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <!-- ===== journal -->
                <Border Grid.Row="3" Style="{StaticResource CardPanel}" Margin="14,4,14,14" Padding="14,10">
                    <StackPanel>
                        <TextBlock Text="// JOURNAL" Style="{StaticResource CardTitle}" />
                        <Rectangle Style="{StaticResource Rule}" Margin="0,0,0,8" />
                        <ItemsControl x:Name="LogList" Height="84">
                            <ItemsControl.Template>
                                <ControlTemplate TargetType="ItemsControl">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ItemsControl.Template>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Style="{StaticResource Mono}" Margin="0,1" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Grain d'ecran, purement decoratif : jamais dans le chemin des clics. -->
            <Rectangle Fill="{StaticResource Scanlines}" IsHitTestVisible="False" />
        </Grid>
    </Border>
</Window>
