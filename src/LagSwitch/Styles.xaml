<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===================================================== palette
         Tiree du logo : noir profond, gris ardoise, rouge d'alerte.
         Le vert n'existe pas dans le logo mais reste la lecture la plus
         immediate pour « la ligne est la ». -->

    <SolidColorBrush x:Key="Background" Color="#FF04060A" />
    <SolidColorBrush x:Key="Card" Color="#FF080C12" />
    <SolidColorBrush x:Key="CardBorder" Color="#FF1B2532" />
    <SolidColorBrush x:Key="CardBorderLit" Color="#FF2C3B4E" />
    <SolidColorBrush x:Key="Field" Color="#FF020407" />
    <SolidColorBrush x:Key="Text" Color="#FFC9D6E4" />
    <SolidColorBrush x:Key="Muted" Color="#FF7E8CA0" />
    <SolidColorBrush x:Key="Dim" Color="#FF4E5C71" />
    <SolidColorBrush x:Key="Accent" Color="#FF2FE08A" />
    <SolidColorBrush x:Key="Online" Color="#FF2FE08A" />
    <SolidColorBrush x:Key="Cut" Color="#FFFF2A2A" />
    <SolidColorBrush x:Key="Warn" Color="#FFE8A33D" />

    <FontFamily x:Key="TerminalFont">Cascadia Mono, Consolas, Courier New</FontFamily>

    <!-- Lignes de balayage : le grain d'ecran cathodique, tres discret. -->
    <DrawingBrush x:Key="Scanlines" TileMode="Tile" Stretch="None"
                  Viewport="0,0,3,3" ViewportUnits="Absolute">
        <DrawingBrush.Drawing>
            <GeometryDrawing Brush="#1E000000">
                <GeometryDrawing.Geometry>
                    <RectangleGeometry Rect="0,0,3,1" />
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- ================================================== typographie -->

    <Style x:Key="H1" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource TerminalFont}" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style x:Key="CardTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource TerminalFont}" />
        <Setter Property="Foreground" Value="{StaticResource Dim}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style x:Key="Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource TerminalFont}" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource Body}">
        <Setter Property="Foreground" Value="{StaticResource Dim}" />
        <Setter Property="FontSize" Value="11" />
    </Style>

    <Style x:Key="Mono" TargetType="TextBlock" BasedOn="{StaticResource Hint}">
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
    </Style>

    <!-- ======================================================== carte -->

    <Style x:Key="CardPanel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Card}" />
        <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="14" />
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <!-- Le filet sous chaque titre de section. -->
    <Style x:Key="Rule" TargetType="Rectangle">
        <Setter Property="Height" Value="1" />
        <Setter Property="Fill" Value="{StaticResource CardBorder}" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <!-- ====================================================== boutons -->

    <Style x:Key="BaseButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource TerminalFont}" />
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="Background" Value="#FF0C121A" />
        <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Shell"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="0">
                        <ContentPresenter x:Name="Label"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          TextElement.FontFamily="{TemplateBinding FontFamily}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Shell" Property="BorderBrush" Value="{StaticResource CardBorderLit}" />
                            <Setter TargetName="Shell" Property="Background" Value="#FF131C27" />
                            <Setter TargetName="Label" Property="TextElement.Foreground" Value="{StaticResource Text}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Shell" Property="Background" Value="#FF1B2837" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Shell" Property="Opacity" Value="0.35" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Foreground" Value="{StaticResource Accent}" />
        <Setter Property="Background" Value="#FF07160F" />
        <Setter Property="BorderBrush" Value="#FF1D5B3F" />
    </Style>

    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Foreground" Value="{StaticResource Cut}" />
        <Setter Property="Background" Value="#FF190709" />
        <Setter Property="BorderBrush" Value="#FF5A1B20" />
    </Style>

    <Style x:Key="WarnButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Foreground" Value="{StaticResource Warn}" />
        <Setter Property="Background" Value="#FF191309" />
        <Setter Property="BorderBrush" Value="#FF5A4520" />
    </Style>

    <Style x:Key="BigButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
    </Style>

    <!-- Croix et trait de la barre de titre. -->
    <Style x:Key="ChromeButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Dim}" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>

    <!-- ================================================ interrupteurs
         Cases a cocher dessinees en ASCII : [ ] et [x]. -->

    <ControlTemplate x:Key="AsciiToggle" TargetType="ToggleButton">
        <Border Background="Transparent" Padding="0,3">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="Marker" Text="[ ]"
                           FontFamily="{StaticResource TerminalFont}"
                           FontSize="12" FontWeight="Bold"
                           Foreground="{StaticResource Dim}"
                           VerticalAlignment="Center" Margin="0,0,8,0" />
                <ContentPresenter x:Name="Label" VerticalAlignment="Center"
                                  TextElement.Foreground="{StaticResource Muted}"
                                  TextElement.FontFamily="{StaticResource TerminalFont}"
                                  TextElement.FontSize="12" />
            </StackPanel>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Marker" Property="Text" Value="[x]" />
                <Setter TargetName="Marker" Property="Foreground" Value="{StaticResource Accent}" />
                <Setter TargetName="Label" Property="TextElement.Foreground" Value="{StaticResource Text}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Label" Property="TextElement.Foreground" Value="{StaticResource Text}" />
                <Setter TargetName="Marker" Property="Foreground" Value="{StaticResource Muted}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.35" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template" Value="{StaticResource AsciiToggle}" />
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template" Value="{StaticResource AsciiToggle}" />
    </Style>

    <!-- ======================================================= champs -->

    <Style x:Key="NumberBox" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource TerminalFont}" />
        <Setter Property="Background" Value="{StaticResource Field}" />
        <Setter Property="Foreground" Value="{StaticResource Accent}" />
        <Setter Property="CaretBrush" Value="{StaticResource Accent}" />
        <Setter Property="SelectionBrush" Value="{StaticResource CardBorderLit}" />
        <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Width" Value="72" />
        <Setter Property="HorizontalContentAlignment" Value="Right" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Shell"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="0">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Shell" Property="BorderBrush" Value="{StaticResource Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SearchBox" TargetType="TextBox" BasedOn="{StaticResource NumberBox}">
        <Setter Property="Width" Value="Auto" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
    </Style>

    <!-- ======================================================= listes -->

    <Style x:Key="PickerList" TargetType="ListBox">
        <Setter Property="Background" Value="{StaticResource Field}" />
        <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>

    <Style TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Shell" Background="Transparent" BorderThickness="2,0,0,0"
                            BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"
                                          TextElement.FontFamily="{StaticResource TerminalFont}"
                                          TextElement.FontSize="12" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Shell" Property="Background" Value="#FF0C141E" />
                            <Setter Property="Foreground" Value="{StaticResource Text}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Shell" Property="Background" Value="#FF0E1B26" />
                            <Setter TargetName="Shell" Property="BorderBrush" Value="{StaticResource Accent}" />
                            <Setter Property="Foreground" Value="{StaticResource Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================================================== ascenseur -->

    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="8" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="{StaticResource CardBorder}" Margin="2,0" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" />
                            </Track.IncreaseRepeatButton>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" />
                            </Track.DecreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
