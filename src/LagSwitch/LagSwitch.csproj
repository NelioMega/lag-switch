<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>LagSwitch</AssemblyName>
    <RootNamespace>LagSwitch</RootNamespace>
    <Version>1.0.0</Version>
    <Product>LagSwitch</Product>
    <Company>NelioMega</Company>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\lagswitch.ico</ApplicationIcon>
    <!-- Les structures WFP sont disposees pour x64 : on ne laisse pas le choix au hasard. -->
    <PlatformTarget>x64</PlatformTarget>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <!-- L'icone sert deux fois : au .exe via ApplicationIcon, et aux fenetres via Window.Icon. -->
    <Resource Include="Assets\lagswitch.ico" />
    <Resource Include="Assets\logo.png" />
  </ItemGroup>

</Project>
